{
  "key": "minimax-h3-single-image-reference",
  "label": "Minimax H3 - Single Image Reference",
  "description": "Turn a reference image into a short video with Minimax H3.",
  "group": "RH",
  "workflowIdEnv": "RUNNINGHUB_WORKFLOW_ID_MINIMAX_H3_SINGLE_IMAGE_REFERENCE",
  "inputs": [
    {
      "name": "image",
      "type": "image",
      "label": "Reference image",
      "required": true,
      "accept": ["image/png", "image/jpeg", "image/webp"],
      "maxBytes": 20971520
    },
    {
      "name": "prompt",
      "type": "textarea",
      "label": "Prompt",
      "required": true,
      "maxLength": 2000
    },
    {
      "name": "duration",
      "type": "select",
      "label": "Duration (seconds)",
      "default": "12",
      "options": ["3", "4", "5", "6", "7", "8", "10", "12", "15"]
    },
    {
      "name": "longestSide",
      "type": "select",
      "label": "Longest side (px)",
      "default": "1344",
      "options": ["608", "736", "864", "960", "1056", "1152", "1216", "1280", "1344", "1376", "1504", "1664", "1824", "1920"]
    },
    {
      "name": "aspectRatio",
      "type": "select",
      "label": "Aspect ratio",
      "default": "9:16",
      "options": ["keep", "1:1", "16:9", "9:16", "2:3"]
    }
  ],
  "nodeMappings": [
    { "input": "image", "nodeId": "236", "fieldName": "image" },
    { "input": "prompt", "nodeId": "239", "fieldName": "PromptState" }
  ],
  "transforms": [
    {
      "type": "secondsToFrames",
      "inputs": { "seconds": "duration" },
      "params": { "fps": "24" },
      "targets": { "frames": { "nodeId": "237", "fieldName": "length" } }
    },
    {
      "type": "aspectRatioDimensions",
      "inputs": { "longestSide": "longestSide", "aspectRatio": "aspectRatio", "image": "image" },
      "params": { "step": "32" },
      "targets": {
        "width": { "nodeId": "237", "fieldName": "width" },
        "height": { "nodeId": "237", "fieldName": "height" }
      }
    }
  ],
  "output": {
    "type": "video",
    "contentType": "video/mp4",
    "extensions": ["mp4"]
  }
}
