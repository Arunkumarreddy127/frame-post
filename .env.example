# Backend
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173,https://test1.oneappstore.in
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=24

# MongoDB
MONGODB_URI=mongodb://localhost:27017/framepost
MONGODB_DATABASE=framepost

# Cloudflare R2 (S3-compatible API)
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=framepost-assets
R2_PUBLIC_BASE_URL=

# OpenAI (server-side only)
OPENAI_API_KEY=
OPENAI_ALLOWED_MODELS=gpt-6-luna,gpt-6.1-sol,gpt-6-astra
OPENAI_IMAGE_ALLOWED_MODELS=gpt-image-2.5-sunburst,gpt-image-2.5-flare
OPENAI_REQUEST_TIMEOUT_SECONDS=120

# RunningHub (server-side only)
RUNNINGHUB_API_KEY=
RUNNINGHUB_BASE_URL=https://www.runninghub.ai
# One workflow ID per definition in backend/src/main/resources/runninghub/workflows/ (named in its workflowIdEnv)
RUNNINGHUB_WORKFLOW_ID_MINIMAX_H3_FF=
RUNNINGHUB_WORKFLOW_ID_SEEDVR2=
# Public backend URL reachable by RunningHub (e.g. Cloudflare tunnel). Leave empty to rely on polling only.
RUNNINGHUB_WEBHOOK_BASE_URL=
# Random string; used as the last path segment of the webhook URL. Required when webhooks are enabled.
RUNNINGHUB_WEBHOOK_SECRET=

# Frontend
VITE_API_BASE_URL=
